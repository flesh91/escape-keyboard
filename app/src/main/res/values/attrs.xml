<resources>

    <declare-styleable name="LatinKeyboardBaseView">
        <!-- Default KeyboardView style. -->
        <attr name="keyboardViewStyle" format="reference" />

        <!-- Image for the key. This image needs to be a StateListDrawable, with the following
             possible states: normal, pressed, checkable, checkable+pressed, checkable+checked,
             checkable+checked+pressed. -->
        <attr name="keyBackground" format="reference" />

        <!-- Size of the text for character keys. -->
        <attr name="keyTextSize" format="dimension" />

        <!-- Size of the text for custom keys with some text and no icon. -->
        <attr name="labelTextSize" format="dimension" />

        <!-- Color to use for the label in a key. -->
        <attr name="keyTextColor" format="color" />

        <!-- Color to use for key hint labels. -->
        <attr name="keyHintColor" format="color" />

        <!-- Color to use for cursor key labels. -->
        <attr name="keyCursorColor" format="color" />

        <!-- Fill and label colour of a sticky modifier (Shift, Ctrl, Alt, Meta) while it is on. -->
        <attr name="keyActiveColor" format="color" />
        <!-- Corner radius of the on/locked fill: the theme's key corner radius -->
        <attr name="keyActiveRadius" format="dimension" />
        <attr name="keyActiveTextColor" format="color" />

        <!-- Bubble shown above a pressed key and its label colour; unset keeps the classic
             dark bubble with white text. -->
        <attr name="keyPreviewBackground" format="reference" />
        <attr name="keyPreviewTextColor" format="color" />

        <!-- Label and icon colour of function keys (Shift, Ctrl, Tab, Backspace, arrows...);
             unset: keyTextColor like the letters. -->
        <attr name="keyFunctionTextColor" format="color" />
        <!-- Own backgrounds for Esc, Enter and the space bar (accent keycaps); unset: the
             keyBackground selector. keyAccentTextColor labels Esc and Enter. -->
        <attr name="keyEscapeBackground" format="reference" />
        <attr name="keyEnterBackground" format="reference" />
        <attr name="keySpaceBackground" format="reference" />
        <attr name="keyAccentTextColor" format="color" />
        <!-- Esc label colour when it differs from keyAccentTextColor -->
        <attr name="keyEscapeTextColor" format="color" />
        <!-- Space bar label colour on its own keycap; unset: keyTextColor -->
        <attr name="keySpaceTextColor" format="color" />

        <!-- Do symbols need to be inverted (for light-background themes)? -->
        <attr name="invertSymbols" format="boolean" />

	<!--  Do symbols need to be recolored? -->
	<attr name="recolorSymbols" format="boolean" />

	<!--  Transparent key background? 0=fully transparent, 255=opaque (fast) -->
	<attr name="backgroundAlpha" format="integer" />
	
        <!-- Layout resource for key press feedback.-->
        <attr name="keyPreviewLayout" format="reference" />

        <!-- Vertical offset of the key press feedback from the key. -->
        <attr name="keyPreviewOffset" format="dimension" />

        <!-- Height of the key press feedback popup. -->
        <attr name="keyPreviewHeight" format="dimension" />

        <!-- Hysteresis distance for key debouncing -->
        <attr name="keyHysteresisDistance" format="dimension" />

        <!-- Amount to offset the touch Y coordinate by, for bias correction. -->
        <attr name="verticalCorrection" format="dimension" />

        <!-- Layout resource for popup keyboards. -->
        <attr name="popupLayout" format="reference" />

        <attr name="shadowColor" format="color" />
        <attr name="shadowRadius" format="float" />
        <attr name="backgroundDimAmount" format="float" />

        <!-- Typeface of letter labels and the key preview; flags, so a family combines
             with a style: "monospace|bold". Function labels keep their own typeface. -->
        <attr name="keyTextStyle">
            <flag name="normal" value="0" />
            <flag name="bold" value="1" />
            <flag name="italic" value="2" />
            <flag name="monospace" value="4" />
        </attr>

        <attr name="symbolColorScheme">
            <flag name="white" value="0" />
            <flag name="black" value="1" />
        </attr>

    </declare-styleable>

</resources>
