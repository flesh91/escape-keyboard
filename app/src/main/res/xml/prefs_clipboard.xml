<?xml version="1.0" encoding="utf-8"?>
<!-- Clipboard history settings -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat
        android:key="clipboard_history"
        android:title="@string/title_clipboard_history"
        android:persistent="true"
        android:defaultValue="true"
        android:summaryOn="@string/summary_clipboard_history_true"
        android:summaryOff="@string/summary_clipboard_history_false" />
    <org.pocketworkstation.pckeyboard.AutoSummaryListPreference
        android:key="clipboard_history_size"
        android:title="@string/title_clipboard_history_size"
        android:persistent="true"
        android:dependency="clipboard_history"
        android:defaultValue="20"
        android:entries="@array/clipboard_history_size_entries"
        android:entryValues="@array/clipboard_history_size_values" />
    <org.pocketworkstation.pckeyboard.AutoSummaryListPreference
        android:key="clipboard_history_expiry"
        android:title="@string/title_clipboard_history_expiry"
        android:persistent="true"
        android:dependency="clipboard_history"
        android:defaultValue="0"
        android:entries="@array/clipboard_history_expiry_entries"
        android:entryValues="@array/clipboard_history_expiry_values" />
    <SwitchPreferenceCompat
        android:key="clipboard_hide_locked"
        android:title="@string/title_clipboard_hide_locked"
        android:summary="@string/summary_clipboard_hide_locked"
        android:persistent="true"
        android:defaultValue="true" />
    <SwitchPreferenceCompat
        android:key="pref_clipboard_offer"
        android:title="@string/title_clipboard_offer"
        android:summary="@string/summary_clipboard_offer"
        android:persistent="true"
        android:defaultValue="@bool/default_clipboard_offer" />

</PreferenceScreen>
