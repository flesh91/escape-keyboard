<Keyboard
    xmlns:android="http://schemas.android.com/apk/res-auto"
    android:keyWidth="26.67%p"
    android:horizontalGap="0px"
    android:verticalGap="@dimen/key_bottom_gap"
>
    <Row
        android:rowEdgeFlags="top"
    >
        <Key
            android:codes="49"
            android:keyLabel="1"
            android:keyEdgeFlags="left" />
        <Key
            android:codes="50"
            android:keyLabel="2"
            android:subLabel="ABC" />
        <Key
            android:codes="51"
            android:keyLabel="3"
            android:subLabel="DEF" />
        <Key
            android:keyLabel="-"
            android:keyWidth="20%p"
            android:isModifier="true"
            android:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            android:codes="52"
            android:keyLabel="4"
            android:subLabel="GHI"
            android:keyEdgeFlags="left" />
        <Key
            android:codes="53"
            android:keyLabel="5"
            android:subLabel="JKL" />
        <Key
            android:codes="54"
            android:keyLabel="6"
            android:subLabel="MNO" />
        <Key
            android:keyLabel="."
            android:keyWidth="20%p"
            android:isModifier="true"
            android:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            android:codes="55"
            android:keyLabel="7"
            android:subLabel="PQRS"
            android:keyEdgeFlags="left" />
        <Key
            android:codes="56"
            android:keyLabel="8"
            android:subLabel="TUV" />
        <Key
            android:codes="57"
            android:keyLabel="9"
            android:subLabel="WXYZ" />
        <Key
            android:codes="@integer/key_delete"
            android:keyIcon="@drawable/sym_keyboard_delete"
            android:iconPreview="@drawable/sym_keyboard_feedback_delete"
            android:keyWidth="20%p"
            android:isModifier="true"
            android:isRepeatable="true"
            android:keyEdgeFlags="right" />
    </Row>
    <Row
        android:rowEdgeFlags="bottom"
    >
        <Key
            android:codes="@integer/key_symbol"
            android:keyLabel="*#("
            android:iconPreview="@drawable/sym_keyboard_feedback_numalt"
            android:keyEdgeFlags="left" />
        <Key
            android:codes="48"
            android:keyLabel="0"
            android:subLabel="+" />
        <Key
            android:codes="@integer/key_space"
            android:keyIcon="@drawable/sym_keyboard_space"
            android:iconPreview="@drawable/sym_keyboard_feedback_space" />
        <Key
            android:codes="@integer/key_return"
            android:keyIcon="@drawable/sym_keyboard_return"
            android:keyWidth="20%p"
            android:isModifier="true"
            android:keyEdgeFlags="right" />
    </Row>
</Keyboard>
