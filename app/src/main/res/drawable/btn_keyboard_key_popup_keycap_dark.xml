<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press panel keys of the Keycap dark theme: the one under the finger turns teal -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="2dp" android:insetRight="2dp"
            android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="6dp" />
                <solid android:color="@color/keycap_dark_selected" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
