<?xml version="1.0" encoding="utf-8"?>
<!-- Mechanical theme: the long-press panel key under the finger, a letter cap pressed
     down with an amber top face; the contour follows the body down -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp" android:insetRight="2dp"
    android:insetTop="2.5dp" android:insetBottom="2.5dp">
    <layer-list>
        <item android:left="-0.25dp" android:top="4.5dp" android:right="-0.25dp" android:bottom="-1dp">
            <shape android:shape="rectangle">
                <corners android:radius="6.5dp" />
                <gradient android:angle="270" android:startColor="@color/mech_shadow_clear" android:endColor="@color/mech_shadow_far" />
            </shape>
        </item>
        <item android:top="4.5dp" android:bottom="-0.5dp">
            <shape android:shape="rectangle">
                <corners android:radius="6.5dp" />
                <gradient android:angle="270" android:startColor="@color/mech_shadow_clear" android:endColor="@color/mech_shadow_near" />
            </shape>
        </item>
        <item android:top="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="6dp" />
                <gradient android:angle="270" android:startColor="@color/mech_letter_side_top" android:centerColor="@color/mech_letter_side_top" android:centerY="0.86" android:endColor="@color/mech_letter_side" />
            </shape>
        </item>
        <item android:top="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="6dp" />
                <solid android:color="@android:color/transparent" />
                <stroke android:width="0.5dp" android:color="@color/mech_contour" />
            </shape>
        </item>
        <item android:left="1.5dp" android:top="2.5dp" android:right="1.5dp" android:bottom="2.25dp">
            <shape android:shape="rectangle">
                <corners android:radius="5dp" />
                <solid android:color="@color/mech_selected_hl" />
            </shape>
        </item>
        <item android:left="1.5dp" android:top="3dp" android:right="1.5dp" android:bottom="1.5dp">
            <shape android:shape="rectangle">
                <corners android:radius="5dp" />
                <gradient android:angle="270" android:startColor="@color/mech_selected" android:endColor="@color/mech_selected_bottom" />
            </shape>
        </item>
    </layer-list>
</inset>
