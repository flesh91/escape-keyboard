<?xml version="1.0" encoding="utf-8"?>
<!-- Graphite theme: suggestion strip: light rim, dark inside -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item><shape android:shape="rectangle"><corners android:radius="0dp" /><solid android:color="@color/graphite_panel_edge" /></shape></item>
    <item android:bottom="1.25dp"><shape android:shape="rectangle"><corners android:radius="0dp" /><solid android:color="@color/graphite_panel_rim" /></shape></item>
    <!-- a line along the top edge only: the other sides of the stroke fall outside the view -->
    <item android:left="-4dp" android:top="0dp" android:right="-4dp" android:bottom="-4dp">
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/graphite_panel_highlight" /></shape>
    </item>
    <item android:left="2.5dp" android:top="2.75dp" android:right="2.5dp" android:bottom="2.75dp">
        <shape android:shape="rectangle"><corners android:radius="1dp" /><gradient android:angle="270" android:startColor="@color/graphite_strip_top" android:centerColor="@color/graphite_strip_center" android:endColor="@color/graphite_strip_top" /></shape>
    </item>
</layer-list>
