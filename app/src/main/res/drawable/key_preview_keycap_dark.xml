<?xml version="1.0" encoding="utf-8"?>
<!-- Keycap dark theme: bubble above a pressed key, a letter cap with its side -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#14000000" /></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle"><corners android:radius="11dp" /><solid android:color="@color/keycap_dark_letter_side" /></shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle"><corners android:radius="10dp" /><solid android:color="@color/keycap_dark_letter" /></shape>
    </item>
</layer-list>
