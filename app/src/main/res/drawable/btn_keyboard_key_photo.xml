<?xml version="1.0" encoding="utf-8"?>
<!-- Real keycaps theme: letter caps and modifier caps; Esc, Enter and the space bar
     have their own (keyEscapeBackground and the like). Every cap has the same padding
     (the Keycap theme's: its inset), which the keyboard reads from this drawable to centre
     the labels. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sticky modifiers (Shift, Ctrl, Alt); keyActiveColor glows over the cap while on. -->
    <item android:state_checkable="true" android:state_pressed="true"
          android:drawable="@drawable/key_photo_func_pressed" />
    <item android:state_checkable="true"
          android:drawable="@drawable/key_photo_func" />
    <!-- Function keys (Backspace, Tab, arrows...). -->
    <item android:state_single="true" android:state_pressed="true"
          android:drawable="@drawable/key_photo_func_pressed" />
    <item android:state_single="true"
          android:drawable="@drawable/key_photo_func" />
    <!-- Empty background keys: bare plate. -->
    <item android:state_empty="true" android:state_pressed="true"
          android:drawable="@drawable/key_photo_letter_pressed" />
    <item android:state_empty="true"
          android:drawable="@drawable/key_photo_plate" />
    <!-- Letter keys. -->
    <item android:state_pressed="true"
          android:drawable="@drawable/key_photo_letter_pressed" />
    <item android:drawable="@drawable/key_photo_letter" />
</selector>
