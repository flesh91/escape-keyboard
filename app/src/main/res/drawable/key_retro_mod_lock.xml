<?xml version="1.0" encoding="utf-8"?>
<!-- Retro terminal theme: sticky modifier locked, LED lit; the cap sits as at rest (like every other theme's locked key), only its colours tell it from "on" -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp" android:insetRight="2dp"
    android:insetTop="2.5dp" android:insetBottom="2.5dp">
    <layer-list>
        <!-- contact shadow on the case -->
        <item android:left="-0.25dp" android:top="1.5dp" android:right="-0.25dp" android:bottom="-1dp">
            <shape android:shape="rectangle"><corners android:radius="5dp" /><solid android:color="@color/retro_shadow" /></shape>
        </item>
        <!-- skirt: the sides and the lower bevel, darker towards the bottom -->
        <item>
            <shape android:shape="rectangle"><corners android:radius="4.5dp" /><gradient android:angle="270" android:startColor="@color/retro_mod_lock_side_top" android:endColor="@color/retro_mod_lock_side" /></shape>
        </item>
        <!-- highlight along the top edge of the face -->
        <item android:left="1.5dp" android:top="0.5dp" android:right="1.5dp" android:bottom="3.5dp">
            <shape android:shape="rectangle"><corners android:radius="3.5dp" /><solid android:color="@color/retro_mod_lock_hi" /></shape>
        </item>
        <!-- face -->
        <item android:left="1.5dp" android:top="1.25dp" android:right="1.5dp" android:bottom="3.5dp">
            <shape android:shape="rectangle"><corners android:radius="3.5dp" /><solid android:color="@color/retro_mod_lock" /></shape>
        </item>
        <!-- LED (on), with the shadow of its recess along the top and left -->
        <item android:left="4.5dp" android:top="3.25dp" android:right="4.5dp" android:bottom="6.5dp">
            <shape android:shape="rectangle"><corners android:radius="0.75dp" /><solid android:color="@color/retro_led_on" /><stroke android:width="0.5dp" android:color="@color/retro_led_on_edge" /></shape>
        </item>
        <!-- face again, below the LED -->
        <item android:left="4dp" android:top="5.75dp" android:right="4dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/retro_mod_lock" /></shape>
        </item>
        <!-- face again, right of the LED -->
        <item android:left="12dp" android:top="2.75dp" android:right="4dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/retro_mod_lock" /></shape>
        </item>
        <!-- matte dish: a touch lighter at the top, darker at the bottom -->
        <item android:left="1.5dp" android:top="0.5dp" android:right="1.5dp" android:bottom="3.5dp">
            <shape android:shape="rectangle"><corners android:radius="3.5dp" /><gradient android:angle="270" android:startColor="@color/retro_dish_top" android:centerColor="@color/retro_dish_mid" android:endColor="@color/retro_dish_bottom" /></shape>
        </item>
    </layer-list>
</inset>
