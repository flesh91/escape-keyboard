<?xml version="1.0" encoding="utf-8"?>
<!-- Real keycaps theme: suggestion strip, autofill row and macro row background
     (LatinIME.applyStripBackground): the aluminium case above the keys, with the same sheen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/photo_strip_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/photo_sheen_clear" android:centerColor="@color/photo_sheen" android:endColor="@color/photo_sheen_clear" />
        </shape>
    </item>
</layer-list>
