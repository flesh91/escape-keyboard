<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press mini keyboard of the Mechanical theme: letter caps in a small aluminium tray.
     Padded like the Keycap theme (left and right only), so the panel sits and sizes the same. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/keyboard_popup_mech_background"
        android:paddingLeft="8dip"
        android:paddingRight="8dip"
        >
    <org.pocketworkstation.pckeyboard.LatinKeyboardBaseView
            xmlns:latin="http://schemas.android.com/apk/res-auto"
            android:id="@+id/LatinKeyboardBaseView"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/latinkeyboard_transparent"
            latin:keyTextStyle="normal"
            latin:keyTextColor="@color/mech_popup_text"
            latin:recolorSymbols="true"
            latin:keyHintColor="@color/mech_popup_hint"
            latin:keyCursorColor="@color/mech_popup_cursor"
            latin:shadowRadius="0"
            latin:keyBackground="@drawable/btn_keyboard_key_popup_mech"
            latin:keyHysteresisDistance="0dip"
            latin:verticalCorrection="@dimen/mini_keyboard_vertical_correction"
            latin:keyPreviewLayout="@layout/null_layout"
            latin:popupLayout="@layout/null_layout"
            />
</LinearLayout>
