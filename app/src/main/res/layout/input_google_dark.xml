<org.pocketworkstation.pckeyboard.LatinKeyboardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:latin="http://schemas.android.com/apk/res-auto"
        android:id="@+id/LatinkeyboardBaseView"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/keyboard_bottom_padding"
        android:background="@color/google_dark_bg"
        latin:shadowRadius="0"
        latin:keyTextColor="@color/google_dark_text"
        latin:keyPreviewBackground="@drawable/key_preview_google_dark"
        latin:keyPreviewTextColor="@color/google_dark_text"
        latin:recolorSymbols="true"
        latin:keyHintColor="@color/google_dark_hint"
        latin:keyCursorColor="@color/google_dark_text"
        latin:keyActiveColor="@color/google_dark_active"
        latin:keyActiveTextColor="@color/google_dark_on_active"

        latin:keyBackground="@drawable/btn_keyboard_key_google_dark"
        latin:popupLayout="@layout/input_popup_google_dark"
        />
