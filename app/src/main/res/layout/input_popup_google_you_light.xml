<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press mini keyboard of the Google style theme -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/keyboard_popup_google_you_light_background"
        android:paddingLeft="8dip"
        android:paddingRight="8dip"
        >
    <org.pocketworkstation.pckeyboard.LatinKeyboardBaseView
            xmlns:latin="http://schemas.android.com/apk/res-auto"
            android:id="@+id/LatinKeyboardBaseView"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/latinkeyboard_transparent"
            latin:keyTextColor="@color/google_you_light_text"
            latin:recolorSymbols="true"
            latin:keyHintColor="@color/google_you_light_hint"
            latin:keyCursorColor="@color/google_you_light_text"
            latin:shadowRadius="0"
            latin:keyBackground="@drawable/btn_keyboard_key_popup_google_you_light"
            latin:keyHysteresisDistance="0dip"
            latin:verticalCorrection="@dimen/mini_keyboard_vertical_correction"
            latin:keyPreviewLayout="@layout/null_layout"
            latin:popupLayout="@layout/null_layout"
            />
</LinearLayout>
