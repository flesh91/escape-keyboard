<?xml version="1.0" encoding="utf-8"?>
<!-- Retro terminal theme, dark. Colours: values/colors_retro.xml (retro_dark_*).
     Letters and the key preview in bold monospace, like a terminal. keyActiveColor is
     #00000000 (off): the sticky modifiers draw their own on and locked caps (an amber cap
     with its LED lit, see drawable/btn_keyboard_key_retro_dark.xml). -->
<org.pocketworkstation.pckeyboard.LatinKeyboardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:latin="http://schemas.android.com/apk/res-auto"
        android:id="@+id/LatinkeyboardBaseView"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/keyboard_bottom_padding"
        android:background="@drawable/keyboard_retro_dark_background"
        latin:shadowRadius="0"
        latin:keyTextStyle="monospace|bold"
        latin:keyTextColor="@color/retro_dark_text"
        latin:keyFunctionTextColor="@color/retro_dark_func_text"
        latin:keyAccentTextColor="@color/retro_dark_accent_text"
        latin:keyEscapeTextColor="@color/retro_dark_esc_text"
        latin:keySpaceTextColor="@color/retro_dark_space_text"
        latin:keyPreviewBackground="@drawable/key_preview_retro_dark"
        latin:keyPreviewTextColor="@color/retro_dark_preview_text"
        latin:recolorSymbols="true"
        latin:keyHintColor="@color/retro_dark_hint"
        latin:keyCursorColor="@color/retro_dark_cursor"
        latin:keyActiveColor="@color/retro_dark_active"
        latin:keyActiveRadius="5dp"
        latin:keyActiveTextColor="@color/retro_dark_on_active"

        latin:keyBackground="@drawable/btn_keyboard_key_retro_dark"
        latin:keyEscapeBackground="@drawable/btn_keyboard_key_retro_dark_esc"
        latin:keyEnterBackground="@drawable/btn_keyboard_key_retro_dark_enter"
        latin:keySpaceBackground="@drawable/btn_keyboard_key_retro_dark_space"
        latin:popupLayout="@layout/input_popup_retro_dark"
        />
