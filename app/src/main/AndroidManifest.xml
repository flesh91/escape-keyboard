<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
>

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.WRITE_USER_DICTIONARY" />
    <!-- Visible packages: dictionary plugin packs (PluginManager) and voice typing keyboards -->
    <queries>
        <intent>
            <action android:name="org.pocketworkstation.DICT" />
        </intent>
        <intent>
            <action android:name="com.menny.android.anysoftkeyboard.DICTIONARY" />
        </intent>
        <!-- Voice input hands over to a voice typing keyboard (e.g. Google voice typing) -->
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:label="@string/english_ime_name"
            android:name="HKApplication"
            android:allowBackup="true"
            android:backupAgent="LatinIMEBackupAgent"
            android:restoreAnyVersion="true"
            android:hardwareAccelerated="true"
            android:killAfterRestore="false"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">

        <service android:name="LatinIME"
                android:exported="true"
                android:label="@string/english_ime_name"
                android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <activity android:name="Main" android:exported="true"
            android:theme="@style/Theme.HK" android:label="@string/english_ime_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name="LatinIMESettings" android:exported="true"
            android:theme="@style/Theme.HK" android:label="@string/english_ime_settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.SETTINGS"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name="InputLanguageSelection" android:exported="true"
            android:theme="@style/Theme.HK"
                android:label="@string/language_selection_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.INPUT_LANGUAGE_SELECTION"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="LicensesActivity" android:exported="false"
            android:theme="@style/Theme.HK"
            android:label="@string/title_licenses" />
        <activity android:name="ClipboardEditActivity" android:exported="false"
            android:theme="@style/Theme.HK.Dialog"
            android:label="@string/clipboard_edit_title"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
</application>
</manifest>
